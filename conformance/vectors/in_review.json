      "id": "in_review_initial",
      "expect": {
        "state": "to_do"
      }
    },
    {
      "feature": "code",
      "id": "in_review_code_s0",
      "state": "to_do",
      "expect": 1
    },
    {
      "feature": "key",
      "id": "in_review_key_s0",
      "code": 1,
      "expect": "to_do"
    },
    {
      "feature": "from_code",
      "id": "in_review_from_code_s0",
      "input": 1,
      "expect": {
        "state": "to_do"
      }
    },
    {
      "feature": "is_final",
      "id": "in_review_is_final_s0",
      "state": "to_do",
      "expect": false
