{
  "machine": "standby",
  "cases": [
    {
      "feature": "initial",
      "id": "standby_initial",
      "expect": {
        "state": "ready"
      }
    },
    {
      "feature": "code",
      "id": "standby_code_s0",
      "state": "ready",
      "expect": 1
    },
    {
      "feature": "key",
      "id": "standby_key_s0",
      "code": 1,
      "expect": "ready"
    },
    {
      "feature": "from_code",
      "id": "standby_from_code_s0",
      "input": 1,
      "expect": {
        "state": "ready"
      }
    },
    {
      "feature": "is_final",
      "id": "standby_is_final_s0",
      "state": "ready",
      "expect": true
    },
    {
      "feature": "events_from",
      "id": "standby_events_from_s0",
      "state": "ready",
      "expect": []
    },
    {
      "feature": "from_code",
      "id": "standby_from_code_zero",
      "input": 0,
      "expect": {
        "error": "E_UNKNOWN_CODE"
      }
    },
    {
      "feature": "from_code",
      "id": "standby_from_code_unknown",
      "input": 2,
      "expect": {
        "error": "E_UNKNOWN_CODE"
      }
    }
  ]
}
