{
  "machine": "two_step",
  "cases": [
    { "feature": "initial", "id": "two_step_initial", "expect": { "state": "start" } },
    { "feature": "code", "id": "two_step_code_s0", "state": "start", "expect": 1 },
    { "feature": "key", "id": "two_step_key_s0", "code": 1, "expect": "start" },
    { "feature": "from_code", "id": "two_step_from_code_s0", "input": 1, "expect": { "state": "start" } },
    { "feature": "is_final", "id": "two_step_is_final_s0", "state": "start", "expect": false },
    { "feature": "events_from", "id": "two_step_events_from_s0", "state": "start", "expect": ["go"] },
    { "feature": "code", "id": "two_step_code_s1", "state": "end", "expect": 2 },
    { "feature": "key", "id": "two_step_key_s1", "code": 2, "expect": "end" },
    { "feature": "from_code", "id": "two_step_from_code_s1", "input": 2, "expect": { "state": "end" } },
    { "feature": "is_final", "id": "two_step_is_final_s1", "state": "end", "expect": true },
    { "feature": "events_from", "id": "two_step_events_from_s1", "state": "end", "expect": [] },
    { "feature": "from_code", "id": "two_step_from_code_zero", "input": 0, "expect": { "error": "E_UNKNOWN_CODE" } },
    { "feature": "from_code", "id": "two_step_from_code_unknown", "input": 3, "expect": { "error": "E_UNKNOWN_CODE" } },
    { "feature": "target", "id": "two_step_target_s0_e0", "state": "start", "event": "go", "expect": { "state": "end" } },
    { "feature": "target", "id": "two_step_target_s1_e0", "state": "end", "event": "go", "expect": { "error": "E_INVALID_TRANSITION" } },
    { "feature": "apply", "id": "two_step_apply_s0_e0_s0", "expected": "start", "event": "go", "actual": "start", "expect": { "to": "end", "changed": true } },
    { "feature": "apply", "id": "two_step_apply_s0_e0_s1", "expected": "start", "event": "go", "actual": "end", "expect": { "to": "end", "changed": false } },
    { "feature": "apply", "id": "two_step_apply_s1_e0_s1", "expected": "end", "event": "go", "actual": "end", "expect": { "error": "E_INVALID_TRANSITION" } },
    { "feature": "persist", "id": "two_step_persist_first", "scenario": "first", "expected": "start", "event": "go", "stored": "start", "expect": { "stored_after": "end", "changed": true } },
    { "feature": "persist", "id": "two_step_persist_retry", "scenario": "retry", "expected": "start", "event": "go", "stored": "end", "expect": { "stored_after": "end", "changed": false } }
  ]
}
