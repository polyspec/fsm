{
    "name": "polyspec/fsm-php",
    "description": "PHP consumer test bed of fsm: the generated state machines, the conformance vectors and the B-4 persistence example (docs/plans/fsm-v1.md, C-2)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "polyspec/orm": "0.0.15"
    },
    "require-dev": {
        "phpunit/phpunit": "13.4.2"
    },
    "repositories": [
        {
            "type": "artifact",
            "url": "../../var/composer-artifacts"
        }
    ],
    "autoload": {
        "psr-4": {
            "Polyspec\\FsmTest\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\FsmTest\\Tests\\": "tests/",
            "Polyspec\\FsmTest\\Model\\": "examples/model/"
        },
        "files": [
            "examples/persist.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        }
    }
}
