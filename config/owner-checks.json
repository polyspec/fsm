      ],
      "targets": [
        "name-test",
        "readme-test",
        "make-install-test",
        "python-tools-test"
      ]
    },
    {
      "paths": [
        "**/*.ts",
        "**/*.mts",
        "**/*.js",
        "**/*.mjs"
      ],
      "targets": [
        "lint-ts",
        "duplication-check"
      ]
    },
    {
      "paths": [
        "**/*.py"
      ],
      "targets": [
        "lint-python",
        "duplication-check"
      ]
    },
    {
      "paths": [
        "**/*.php"
      ],
      "targets": [
        "lint-php",
        "duplication-check"
      ]
    },
    {
      "paths": [
        "**/*.go"
      ],
      "targets": [
