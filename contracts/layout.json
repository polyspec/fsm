{
  "schema": 1,
  "comment": "The canonical layout of the language packages (docs/plans/fsm-v1.md, C-2): every kind package holds the canonical files and directories, its required files and only files that its allowed globs match. Each package item (S-09-1 to S-14-1) adds its kind. The language-forced difference of rust: it has no examples/model/, because its build.rs generates the orm model of schema/persist.dbs into OUT_DIR.",
  "tools": [
    "fsm-compiler",
    "fsm-db",
    "fsm-gui"
  ],
  "canonical": {
    "files": [
      "README.md",
      "README.ko.md",
      "Makefile"
    ],
    "directories": [
      "src",
      "tests",
      "examples"
    ]
  },
  "kinds": {
    "go": {
      "required": [
        "go.mod",
        "go.sum",
        "tests/conformance_test.go",
        "tests/vectors_test.go",
        "examples/persist.go"
      ],
      "allowed": [
        "src/**/*.go",
        "examples/model/**"
      ],
      "generated": [
        "src/**",
        "tests/vectors_test.go",
        "examples/model/**"
      ]
    },
    "npm": {
      "required": [
        "package.json",
        "package-lock.json",
        "tests/conformance.test.mjs",
        "tests/vectors.mjs",
        "examples/persist.mjs"
      ],
      "allowed": [
        "src/*.js",
        "src/*.d.ts",
        "examples/model/**",
        "tests/types.test.mjs",
        "tests/types/**",
        "tests/persist-dialects.test.mjs"
      ],
      "generated": [
        "src/**",
        "tests/vectors.mjs",
        "examples/model/**"
      ]
    },
    "php": {
      "required": [
        "composer.json",
        "composer.lock",
        "tests/ConformanceCase.php",
        "tests/ConformanceTest.php",
        "examples/persist.php"
      ],
      "allowed": [
        "src/**/*.php",
        "examples/model/**"
      ],
      "generated": [
        "src/**",
        "tests/ConformanceTest.php",
        "examples/model/**"
      ]
    },
    "rust": {
      "required": [
        "Cargo.toml",
        "Cargo.lock",
        "build.rs",
        "tests/conformance.rs",
        "tests/vectors.rs",
        "examples/persist.rs"
      ],
      "allowed": [
        "src/*.rs",
        "tests/persist_retry.rs"
      ],
      "generated": [
        "src/**",
        "tests/vectors.rs"
      ]
    },
    "python": {
      "required": [
        "pyproject.toml",
        "uv.lock",
        "tests/test_conformance.py",
        "tests/vectors.py",
        "examples/persist.py"
      ],
      "allowed": [
        "src/polyspec_fsm/*.py",
        "examples/model/**",
   "pylock.toml"
      ],
      "generated": [
        "src/**",
        "tests/vectors.py",
        "examples/model/**"
      ]
    },
    "php-ext": {
      "required": [
        "composer.json",
        "composer.lock",
        "tests/ConformanceCase.php",
        "tests/ConformanceTest.php",
        "examples/persist.php"
      ],
      "allowed": [
        "src/**",
        "examples/model/**"
      ],
      "generated": [
        "src/**",
        "tests/ConformanceCase.php",
        "tests/ConformanceTest.php",
        "examples/persist.php",
        "examples/model/**"
      ]
    }
  },
  "differences": [
    {
      "kind": "npm",
      "path": "tests/types.test.mjs",
      "reason": "the type check of the generated declarations (S-09-2, make npm-types): TypeScript compiles tests/types/consumer.ts in strict mode against src/*.d.ts; only npm ships declaration files"
    },
    {
      "kind": "npm",
      "path": "tests/types/**",
      "reason": "the consumer files that the type check compiles (tests/types/consumer.ts); they are compiled, not run, so they have no vector case"
    },
    {
      "kind": "rust",
      "path": "tests/persist_retry.rs",
      "reason": "the retry test of the persist example (B-4: a deadlock runs the transaction again, another error does not): a tool test with its own record (make rust-persist-test, S-31); the conformance test of the kind holds the vector cases alone for kit's parity check"
    },
    {
      "kind": "npm",
      "path": "tests/persist-dialects.test.mjs",
      "reason": "the concurrency proof of the persistence pattern (B-4, plan C-4): two transactions of one row, concurrent on postgres and mysql, run through the dialect helper of fsm-db; a tool test with its own record (make npm-persist-test*), so the vector record of the kind holds the vector cases alone"
    }
  ]
}
