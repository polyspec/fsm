    {
      "feature": "persist",
      "id": "in_review_persist_first",
      "scenario": "first",
      "expected": "to_do",
      "event": "start_work",
      "stored": "to_do",
      "expect": {
        "stored_after": "in_progress",
        "changed": true
      }
    },
    {
      "feature": "persist",
      "id": "in_review_persist_retry",
      "scenario": "retry",
      "expected": "to_do",
      "event": "start_work",
      "stored": "in_progress",
      "expect": {
        "stored_after": "in_progress",
        "changed": false
      }
