    {
      "feature": "apply",
      "id": "in_review_apply_s0_e0_s1",
      "expected": "to_do",
      "event": "start_work",
      "actual": "in_progress",
      "expect": {
        "to": "in_progress",
        "changed": false
      }
    },
    {
      "feature": "apply",
      "id": "in_review_apply_s0_e0_s2",
      "expected": "to_do",
      "event": "start_work",
      "actual": "done_now",
      "expect": {
        "error": "E_CONFLICT"
      }
    },
    {
      "feature": "apply",
      "id": "in_review_apply_s1_e1_s1",
      "expected": "in_progress",
      "event": "finish_work",
      "actual": "in_progress",
      "expect": {
        "to": "done_now",
        "changed": true
      }
    },
    {
      "feature": "apply",
      "id": "in_review_apply_s1_e1_s2",
      "expected": "in_progress",
      "event": "finish_work",
      "actual": "done_now",
      "expect": {
        "to": "done_now",
        "changed": false
      }
    },
    {
      "feature": "apply",
      "id": "in_review_apply_s1_e1_s0",
      "expected": "in_progress",
      "event": "finish_work",
      "actual": "to_do",
      "expect": {
        "error": "E_CONFLICT"
      }
    },
    {
      "feature": "apply",
      "id": "in_review_apply_s1_e2_s1",
      "expected": "in_progress",
      "event": "reopen_work",
      "actual": "in_progress",
      "expect": {
        "to": "to_do",
        "changed": true
      }
    },
    {
      "feature": "apply",
      "id": "in_review_apply_s1_e2_s0",
      "expected": "in_progress",
      "event": "reopen_work",
      "actual": "to_do",
      "expect": {
        "to": "to_do",
        "changed": false
      }
    },
    {
      "feature": "apply",
      "id": "in_review_apply_s1_e2_s2",
      "expected": "in_progress",
      "event": "reopen_work",
      "actual": "done_now",
      "expect": {
        "error": "E_CONFLICT"
      }
    },
    {
      "feature": "apply",
      "id": "in_review_apply_s0_e1_s0",
      "expected": "to_do",
      "event": "finish_work",
      "actual": "to_do",
      "expect": {
        "error": "E_INVALID_TRANSITION"
      }
    },
    {
      "feature": "apply",
      "id": "in_review_apply_s0_e2_s0",
      "expected": "to_do",
      "event": "reopen_work",
      "actual": "to_do",
      "expect": {
