{
  "schema": 1,
  "comment": "The checks that own each tracked path, read by kit's owner-check: during an item only the owners of the changed paths run; make check runs the full suite once per tree. Each checklist item adds the rules of the paths it creates.",
  "owners": [
    {
      "paths": [
        "**"
      ],
      "targets": [
        "name-check"
      ]
    },
    {
      "paths": [
        "scripts/check-name.mts",
        "tests/check-name/**"
      ],
      "targets": [
        "name-test",
        "name-check"
      ]
    },
    {
      "paths": [
        "package.json",
        "package-lock.json",
        ".npmrc",
        "PRINCIPLES.md",
        "PRINCIPLES.ko.md",
        ".editorconfig",
        "config/**",
        "Makefile",
        ".gitignore",
        "mise.toml"
      ],
      "targets": [
        "owner-validate",
        "docs-check"
      ]
    },
    {
      "paths": [
        ".githooks/**"
      ],
      "targets": [
        "hooks-check"
      ]
    },
    {
      "paths": [
        "**/*.md"
      ],
      "targets": [
        "docs-check"
      ]
    },
    {
      "paths": [
        "config/layout.yml",
        "config/layout.kit.yml"
      ],
      "targets": [
        "layout-check"
      ]
    },
    {
      "paths": [
        "legacy/packages/compiler/**",
        "contracts/schema/fsm.schema.json",
        "contracts/machines/**",
        "contracts/fsm.lock.json",
        "contracts/conformance/**",
        "contracts/features.json",
        "contracts/fsm.config.json"
      ],
      "targets": [
        "compiler-test",
        "gui-test"
      ]
    },
    {
      "paths": [
        "legacy/packages/db/**",
        "legacy/packages/db/schema/**"
      ],
      "targets": [
        "db-test",
        "gui-test",
        "db-test-postgres",
        "db-test-mysql"
      ]
    },
    {
      "paths": [
        "legacy/packages/js/**"
      ],
      "targets": [
        "layout-check",
        "fsm-js-test",
        "npm-types",
        "npm-persist-test",
        "npm-persist-test-postgres",
        "npm-persist-test-mysql"
      ]
    },
    {
      "paths": [
        "legacy/packages/go/**"
      ],
      "targets": [
        "layout-check",
        "legacy-test-go",
        "go-persist-test-postgres",
        "go-persist-test-mysql"
      ]
    },
    {
      "paths": [
        "contracts/schema/persist.dbs",
        "contracts/schema/dbspec-set.json"
      ],
      "targets": [
        "packages-test"
      ]
    },
    {
      "paths": [
        "packages/gui/**"
      ],
      "targets": [
        "gui-test",
        "gui-browser-test"
      ]
    },
    {
      "paths": [
        "legacy/packages/compiler/**",
        "contracts/schema/fsm.schema.json",
        "contracts/machines/**",
        "contracts/fsm.lock.json",
        "contracts/conformance/**",
        "contracts/features.json",
        "contracts/fsm.config.json"
      ],
      "targets": [
        "compiler-test"
      ]
    },
    {
      "paths": [
        "legacy/packages/db/**",
        "legacy/packages/db/schema/**"
      ],
      "targets": [
        "db-test",
        "db-test-postgres",
        "db-test-mysql"
      ]
    },
    {
      "paths": [
        "legacy/packages/php/**"
      ],
      "targets": [
        "layout-check",
        "legacy-test-php",
        "php-persist-test-postgres",
        "php-persist-test-mysql"
      ]
    },
    {
      "paths": [
        "package.json",
        "package-lock.json",
        ".npmrc",
        "PRINCIPLES.md",
        "PRINCIPLES.ko.md",
        ".editorconfig",
        "config/**",
        "Makefile",
        ".gitignore",
        "mise.toml",
        "mise.lock",
        "rust-toolchain.toml",
        ".php-version"
      ],
      "targets": [
        "owner-validate",
        "docs-check"
      ]
    },
    {
      "paths": [
        "legacy/packages/rust/**"
      ],
      "targets": [
        "layout-check",
        "rust-persist-test",
        "legacy-test-rust",
        "rust-persist-test-postgres",
        "rust-persist-test-mysql"
      ]
    },
    {
      "paths": [
        "legacy/packages/js/**"
      ],
      "targets": [
        "layout-check",
        "fsm-js-test",
        "npm-persist-test",
        "npm-persist-test-postgres",
        "npm-persist-test-mysql"
      ]
    },
    {
      "paths": [
        "legacy/packages/python/**"
      ],
      "targets": [
        "layout-check",
        "legacy-test-python",
        "python-persist-test-postgres",
        "python-persist-test-mysql"
      ]
    },
    {
      "paths": [
        "legacy/packages/php-ext/**"
      ],
      "targets": [
        "layout-check",
        "legacy-test-php-ext",
        "php-ext-persist-test-postgres",
        "php-ext-persist-test-mysql"
      ]
    },
    {
      "paths": [
        "**/*.md",
        "docs/.vitepress/**"
      ],
      "targets": [
        "docs-build"
      ]
    },
    {
      "paths": [
        "scripts/check-readmes.mts",
        "tests/check-readmes/**"
      ],
      "targets": [
        "readme-test",
        "readme-check"
      ]
    },
    {
      "paths": [
        "**/README.md",
        "**/README.ko.md"
      ],
      "targets": [
        "readme-check"
      ]
    },
    {
      "paths": [
        "docs/package.json",
        "docs/package-lock.json"
      ],
      "targets": [
        "docs-build"
      ]
    },
    {
      "paths": [
        "tests/docs-build/**"
      ],
      "targets": [
        "docs-build-test"
      ]
    },
    {
      "paths": [
        "tests/npm-types/**"
      ],
      "targets": [
        "npm-types"
      ]
    },
    {
      "paths": [
