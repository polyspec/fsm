      "expect": [
        "start_work"
      ]
    },
    {
      "feature": "code",
      "id": "in_review_code_s1",
      "state": "in_progress",
      "expect": 2
    },
    {
      "feature": "key",
      "id": "in_review_key_s1",
      "code": 2,
      "expect": "in_progress"
    },
    {
      "feature": "from_code",
      "id": "in_review_from_code_s1",
      "input": 2,
      "expect": {
        "state": "in_progress"
      }
    },
    {
      "feature": "is_final",
      "id": "in_review_is_final_s1",
      "state": "in_progress",
      "expect": false
    },
    {
      "feature": "events_from",
      "id": "in_review_events_from_s1",
      "state": "in_progress",
      "expect": [
        "finish_work",
        "reopen_work"
      ]
    },
    {
      "feature": "code",
      "id": "in_review_code_s2",
      "state": "done_now",
      "expect": 3
    },
    {
      "feature": "key",
      "id": "in_review_key_s2",
      "code": 3,
      "expect": "done_now"
    },
    {
      "feature": "from_code",
      "id": "in_review_from_code_s2",
      "input": 3,
      "expect": {
        "state": "done_now"
      }
    },
    {
      "feature": "is_final",
      "id": "in_review_is_final_s2",
      "state": "done_now",
      "expect": true
