dnl Code generated by fsm-gen from fsm; DO NOT EDIT.
PHP_ARG_ENABLE([polyspec-fsm], [whether to enable polyspec_fsm],
  [AS_HELP_STRING([--enable-polyspec-fsm], [Enable polyspec_fsm, the fsm state machines of the fsm definitions])], [yes])

if test "$PHP_POLYSPEC_FSM" != "no"; then
  PHP_NEW_EXTENSION([polyspec_fsm], [fsm.c order.c], [$ext_shared],, [-std=gnu11 -Wall -Wextra -Wno-unused-parameter -Wno-unused-const-variable])
fi
