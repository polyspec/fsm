        "duplication-check"
      ]
    },
    {
      "paths": [
        "**/*.rs"
      ],
      "targets": [
        "lint-rust",
        "duplication-check"
      ]
    },
    {
      "paths": [
        "legacy/packages/php-ext/**"
      ],
      "targets": [
        "legacy-lint-php-ext",
        "duplication-check"
      ]
    },
    {
      "paths": [
        ".oxlintrc.json",
        "knip.jsonc"
      ],
      "targets": [
        "lint-ts"
      ]
    },
    {
      "paths": [
        "ruff.toml",
        "legacy/packages/python/pyproject.toml"
      ],
      "targets": [
        "lint-python"
      ]
    },
    {
      "paths": [
        "phpcs.xml.dist",
        "phpstan.dist.neon"
      ],
      "targets": [
        "lint-php"
      ]
    },
    {
      "paths": [
        ".golangci.yml"
      ],
      "targets": [
        "lint-go"
      ]
    },
    {
      "paths": [
        "clippy.toml",
        "legacy/packages/rust/Cargo.toml"
      ],
      "targets": [
        "lint-rust"
      ]
    },
    {
      "paths": [
        "packages/rust/**",
        "contracts/cases.json",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "targets": [
        "test-rust",
        "lint-rust"
      ]
    }
  ]
}
