{
  "schema": 1,
  "implementations": [
    { "name": "go", "runner": "go", "roots": ["packages/go"], "tests": ["packages/go/tests/conformance_test.go"],
      "support": ["packages/go/tests/vectors_test.go"] },
    { "name": "npm", "runner": "node", "roots": ["packages/js"], "tests": ["packages/js/tests/conformance.test.mjs"] },
    { "name": "php", "runner": "php", "roots": ["packages/php"], "tests": ["packages/php/tests/ConformanceTest.php"] },
    { "name": "php-ext", "runner": "php", "roots": ["packages/php-ext"], "tests": ["packages/php-ext/tests/ConformanceTest.php"],
      "support": ["packages/php-ext/src/polyspec_fsm_test.stub.php", "packages/php-ext/src/php_polyspec_fsm_test.h"],
      "args": ["-d", "extension=packages/php-ext/src/modules/polyspec_fsm_test.so"] },
    { "name": "python", "runner": "python", "roots": ["packages/python"], "tests": ["packages/python/tests/test_conformance.py"],
      "command": "packages/python/.venv/bin/python" },
    { "name": "rust", "runner": "cargo", "roots": ["packages/rust"], "tests": ["packages/rust/tests/conformance.rs"] }
  ],
  "profiles": [{ "name": "fsm", "implementations": ["go", "npm", "php", "php-ext", "python", "rust"] }],
  "suites": ["contracts/conformance/vectors.json"],
  "tools": [
    { "root": "packages/compiler", "reason": "the node tests of the compiler (fsm-gen): validation, stores and backends, one implementation that every kind's code comes from (plan C-5)" },
    { "root": "packages/db", "reason": "the node tests of the DB store and its CLI, a component of fsm, not a port of the spec (plan C-6)" },
    { "root": "packages/gui", "reason": "the node tests of the GUI, a component of fsm, not a port of the spec (plan C-7)" },
    { "root": "tests", "reason": "the node tests of the root tools (check-name, check-readmes, gen-check, the documentation site, the make targets and the workflows), which implement no contract" }
  ],
  "testPatterns": [
    { "runner": "go", "globs": ["packages/*/tests/conformance_test.go"] },
    { "runner": "node", "globs": ["packages/*/tests/conformance.test.mjs"] },
    { "runner": "php", "globs": ["packages/*/tests/ConformanceTest.php"] },
    { "runner": "python", "globs": ["packages/*/tests/test_conformance.py"] },
    { "runner": "cargo", "globs": ["packages/*/tests/conformance.rs"] }
  ],
  "units": [
    { "id": "vectors", "kind": "suite", "profile": "fsm", "file": "contracts/conformance/vectors.json", "cases": "$.machines[*].cases[*].name",
      "admit": "kinds",
      "bindings": [
        { "implementation": "go", "test": "packages/go/tests/conformance_test.go", "symbol": "TestConformance" },
        { "implementation": "npm", "test": "packages/js/tests/conformance.test.mjs" },
        { "implementation": "php", "test": "packages/php/tests/ConformanceTest.php" },
        { "implementation": "php-ext", "test": "packages/php-ext/tests/ConformanceTest.php" },
        { "implementation": "python", "test": "packages/python/tests/test_conformance.py" },
        { "implementation": "rust", "test": "packages/rust/tests/conformance.rs", "symbol": "vectors" }
      ] }
  ],
  "exclusions": []
}
