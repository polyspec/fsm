{
  "schema": 1,
  "comment": "The checks that own each tracked path, read by scripts/kit/owner-check.mjs: during an item only the owners of the changed paths run; make check runs the full suite once per tree. Each checklist item adds the rules of the paths it creates.",
  "owners": [
    {
      "paths": [
        "**"
      ],
      "targets": [
        "name-check"
      ]
    },
    {
      "paths": [
        "scripts/check-name.mjs",
        "tests/check-name/**"
      ],
      "targets": [
        "name-test",
        "name-check"
      ]
    },
    {
      "paths": [
        "scripts/kit/**",
        "tests/kit/**",
        ".kit/**",
        "kit.json",
        "config/**",
        "Makefile",
        ".gitignore",
        ".node-version"
      ],
      "targets": [
        "kit-check",
        "owner-validate",
        "documents-check",
        "commits-check",
        "toolchain-check",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        ".githooks/**"
      ],
      "targets": [
        "hooks-check"
      ]
    },
    {
      "paths": [
        "**/*.md"
      ],
      "targets": [
        "documents-check"
      ]
    },
    {
      "paths": [
        "scripts/check-layout.mjs",
        "tests/check-layout/**"
      ],
      "targets": [
        "layout-test",
        "layout-check"
      ]
    },
    {
      "paths": [
        "contracts/layout.json"
      ],
      "targets": [
        "layout-test",
        "layout-check"
      ]
    },
    {
      "paths": [
        "scripts/check-parity.mjs",
        "tests/check-parity/**"
      ],
      "targets": [
        "parity-test"
      ]
    },
    {
      "paths": [
        "packages/fsm-compiler/**",
        "schema/fsm.schema.json",
        "machines/**",
        "fsm.lock.json",
        "conformance/**",
        "contracts/features.json",
        "fsm.config.json"
      ],
      "targets": [
        "compiler-test",
        "gen-check",
        "gui-test"
      ]
    },
    {
      "paths": [
        "scripts/gen-check.mjs",
        "tests/gen-check/**"
      ],
      "targets": [
        "gen-check-test",
        "gen-check"
      ]
    },
    {
      "paths": [
        "packages/fsm-db/**",
        "schema/fsm.dbs"
      ],
      "targets": [
        "db-test",
        "dependency-policy-check",
        "gui-test"
      ]
    },
    {
      "paths": [
        "contracts/layout.json"
      ],
      "targets": [
        "layout-test",
        "layout-check",
        "gen-check",
        "packages-test"
      ]
    },
    {
      "paths": [
        "packages/fsm-npm/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "parity-npm",
        "npm-types",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        "packages/fsm-go/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "parity-go",
        "dependency-policy-check",
        "toolchain-check"
      ]
    },
    {
      "paths": [
        "schema/persist.dbs"
      ],
      "targets": [
        "gen-check",
        "packages-test"
      ]
    },
    {
      "paths": [
        "packages/fsm-gui/**"
      ],
      "targets": [
        "gui-test",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        "packages/fsm-compiler/**",
        "schema/fsm.schema.json",
        "machines/**",
        "fsm.lock.json",
        "conformance/**",
        "contracts/features.json",
        "fsm.config.json"
      ],
      "targets": [
        "compiler-test",
        "gen-check"
      ]
    },
    {
      "paths": [
        "packages/fsm-db/**",
        "schema/fsm.dbs"
      ],
      "targets": [
        "db-test",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        "packages/fsm-php/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "parity-php",
        "dependency-policy-check",
        "toolchain-check"
      ]
    },
    {
      "paths": [
        "scripts/kit/**",
        "tests/kit/**",
        ".kit/**",
        "kit.json",
        "config/**",
        "Makefile",
        ".gitignore",
        ".node-version",
        "rust-toolchain.toml"
      ],
      "targets": [
        "kit-check",
        "owner-validate",
        "documents-check",
        "commits-check",
        "toolchain-check",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        "packages/fsm-rust/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "parity-rust",
        "dependency-policy-check",
        "toolchain-check"
      ]
    },
    {
      "paths": [
        "packages/fsm-npm/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "parity-npm",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        "packages/fsm-python/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "parity-python",
        "dependency-policy-check",
        "toolchain-check"
      ]
    },
    {
      "paths": [
        "packages/fsm-php-ext/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "parity-php-ext",
        "dependency-policy-check",
        "toolchain-check"
      ]
    },
    {
      "paths": [
        "**/*.md",
        "docs/.vitepress/**"
      ],
      "targets": [
        "docs-build"
      ]
    },
    {
      "paths": [
        "docs/package.json",
        "docs/package-lock.json"
      ],
      "targets": [
        "docs-build",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        "tests/docs-build/**"
      ],
      "targets": [
        "docs-build-test"
      ]
    }
  ]
}
