{
  "title": "fsm definition",
  "description": "Editor schema of a fsm machine definition. It checks the structure only; the core validation (docs/spec/fsm.md, B-5) is the authority.",
  "type": "object",
  "required": ["machine", "states", "events"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "description": "The path of this schema, for editors; the stores strip it." },
    "machine": { "type": "string", "description": "The machine key, the name of the module that is generated." },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "code"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "code": { "type": "integer", "description": "The stored value; 1 to 2147483647." },
          "initial": { "const": true, "description": "Marks the single initial state; omitted otherwise." },
          "final": { "const": true, "description": "Marks a final state; omitted otherwise." }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "edges"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "edges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["from", "to"],
              "additionalProperties": false,
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
