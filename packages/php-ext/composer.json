{
    "name": "polyspec/fsm-php-ext",
    "description": "PHP extension of fsm: the generated state machines as one C extension, the conformance vectors and the B-4 persistence example (docs/plans/fsm-v1/plan.md, C-2)",
    "version": "0.0.1",
    "type": "php-ext",
    "license": "MIT",
    "php-ext": {
        "extension-name": "polyspec_fsm",
        "build-path": "src"
    },
    "require": {
        "php": ">=8.4",
        "polyspec/orm": "0.0.18"
    },
    "require-dev": {
        "phpunit/phpunit": "13.4.2"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://github.com/polyspec/ordered-json/releases/download/v0.0.14/packages.json"
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/yaml",
            "no-api": true
        }
    ],
    "config": {
        "platform": {
            "php": "8.4.1"
        }
    }
}
