{
    "name": "polyspec/fsm",
    "description": "PHP package of fsm: the generated state machines, the conformance vectors and the B-4 persistence example (docs/plans/fsm-v1/plan.md, C-2)",
    "version": "0.0.2",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "polyspec/orm": "0.0.21"
    },
    "require-dev": {
        "phpunit/phpunit": "13.4.2"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://github.com/polyspec/orm/releases/download/v0.0.21/packages.json"
        },
        {
            "type": "composer",
            "url": "https://github.com/polyspec/ordered-json/releases/download/v0.0.18/packages.json"
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/yaml",
            "no-api": true
        }
    ],
    "autoload": {
        "psr-4": {
            "Polyspec\\FsmTest\\": "src/"
        },
        "files": [
            "src/InReview/functions.php",
            "src/Limits/functions.php",
            "src/Order/functions.php",
            "src/Standby/functions.php",
            "src/Ticket/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\FsmTest\\Tests\\": "tests/",
            "Polyspec\\FsmTest\\Model\\": "examples/model/"
        },
        "files": [
            "examples/persist.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.5.1"
        }
    }
}
