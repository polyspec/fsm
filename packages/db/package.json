{
  "name": "@polyspec/fsm-db",
  "version": "0.0.0",
  "private": true,
  "description": "DbStore of fsm: the definitions and the lock in orm tables (docs/plans/fsm-v1/plan.md, C-6)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.0"
  },
  "bin": {
    "fsm-db": "src/cli/fsm-db.mjs"
  },
  "scripts": {
    "gen": "orm-gen gen --set schema/dbspec-set.json --out src/models --scan src"
  },
  "dependencies": {
    "@polyspec/ordered-json": "https://github.com/polyspec/ordered-json/releases/download/v0.0.14/polyspec-ordered-json-npm-0.0.14.tgz",
    "@polyspec/orm": "https://github.com/polyspec/orm/releases/download/v0.0.18/polyspec-orm-npm-0.0.18.tgz"
  },
  "overrides": {
    "@polyspec/ordered-json": "$@polyspec/ordered-json"
  },
  "devDependencies": {
    "mysql2": "3.24.6",
    "pg": "8.23.1"
  }
}
