{
  "name": "@polyspec/fsm-gui",
  "version": "0.0.0",
  "private": true,
  "description": "GUI of fsm: hyper server, crudui list and detail, Mermaid display (docs/plans/fsm-v1/plan.md, C-7)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "fsm-gui": "src/main.mjs"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "build": "hyper-build-assets --app . --api /api --output build",
    "start": "node src/main.mjs"
  },
  "dependencies": {
    "@polyspec/crudui-generator-core": "https://github.com/polyspec/crudui/releases/download/v0.0.5/polyspec-crudui-generator-core-npm-0.0.5.tgz",
    "@polyspec/crudui-generator-html": "https://github.com/polyspec/crudui/releases/download/v0.0.5/polyspec-crudui-generator-html-npm-0.0.5.tgz",
    "@polyspec/crudui-validator": "https://github.com/polyspec/crudui/releases/download/v0.0.5/polyspec-crudui-validator-npm-0.0.5.tgz",
    "@polyspec/hyper-build": "https://github.com/polyspec/hyper/releases/download/v0.0.17/polyspec-hyper-build-npm-0.0.17.tgz",
    "@polyspec/hyper-client": "https://github.com/polyspec/hyper/releases/download/v0.0.17/polyspec-hyper-client-npm-0.0.17.tgz",
    "@polyspec/hyper-server": "https://github.com/polyspec/hyper/releases/download/v0.0.17/polyspec-hyper-server-npm-0.0.17.tgz",
    "@polyspec/template": "https://github.com/polyspec/template/releases/download/v0.0.9/polyspec-template-npm-0.0.9.tgz",
    "@polyspec/template-compiler": "https://github.com/polyspec/template/releases/download/v0.0.9/polyspec-template-compiler-npm-0.0.9.tgz",
    "htmx.org": "4.0.0",
    "mermaid": "12.2.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@polyspec/crudui-generator-core": "$@polyspec/crudui-generator-core",
    "@polyspec/crudui-validator": "$@polyspec/crudui-validator",
    "@polyspec/hyper-client": "$@polyspec/hyper-client",
    "@polyspec/template": "$@polyspec/template",
    "@polyspec/template-compiler": "$@polyspec/template-compiler"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
