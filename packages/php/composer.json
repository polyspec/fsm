{
    "name": "polyspec/fsm",
    "description": "PHP consumer test bed of fsm: the generated state machines, the conformance vectors and the B-4 persistence example (docs/plans/fsm-v1/plan.md, C-2)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "polyspec/orm": "0.0.18"
    },
    "require-dev": {
        "phpunit/phpunit": "13.4.2"
    },
    "repositories": [
        {
            "type": "artifact",
            "url": "../../var/composer-artifacts"
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/yaml",
            "no-api": true
        }
    ],
    "autoload": {
        "psr-4": {
            "Polyspec\\FsmTest\\": "src/"
        },
        "files": [
            "src/InReview/functions.php",
            "src/Limits/functions.php",
            "src/Order/functions.php",
            "src/Standby/functions.php",
            "src/Ticket/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\FsmTest\\Tests\\": "tests/",
            "Polyspec\\FsmTest\\Model\\": "examples/model/"
        },
        "files": [
            "examples/persist.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        }
    }
}
