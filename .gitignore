.DS_Store
/var/
# The root packages of package-lock.json, @polyspec/kit among them (make install-packages).
/node_modules/
/.results/
/packages/*/node_modules/
# The documentation site (docs/.vitepress/config.mts, make docs-build): the packages it installs and its build output.
/docs/node_modules/
/docs/.vitepress/dist/
/docs/.vitepress/cache/
/packages/*/vendor
/packages/*/target/
/packages/python/**/__pycache__/
/packages/python/.venv/
/packages/python/src/*.egg-info/
# The files that fsm-gen and orm-gen write (make fsm-gen and make fsm-db-gen; AGENTS.md, Generated files). The golden files of
# packages/compiler/tests/golden are their tracked proof. /packages/php-ext/src/ holds the phpize output too.
/packages/db/src/models/
/packages/go/src/
/packages/go/examples/model/
/packages/js/src/
/packages/js/examples/model/
/packages/php/src/
/packages/php/examples/model/
/packages/php-ext/src/
/packages/php-ext/tests/
/packages/php-ext/examples/
/packages/python/src/polyspec_fsm/
/packages/python/examples/model/
/packages/rust/src/
/packages/gui/build/
/packages/gui/public/assets/
/packages/php*/.phpunit.result.cache
/packages/php*/.phpunit.cache/

# Generated files of the install, build, cache and test runs (AGENTS.md, Generated files)
vendor/
target/
dist/
dist.next/
dist.old/
*.tsbuildinfo
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.phpunit.cache/
.phpunit.result.cache
test-results/
playwright-report/
coverage/

# The go.work that kit link writes for each Go module (kit local-links)
go.work
go.work.sum
