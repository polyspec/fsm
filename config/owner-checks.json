{
  "schema": 1,
  "comment": "The checks that own each tracked path, read by scripts/kit/owner-check.mjs: during an item only the owners of the changed paths run; make check runs the full suite once per tree. Each checklist item adds the rules of the paths it creates.",
  "owners": [
    {
      "paths": [
        "scripts/kit/**",
        "tests/kit/**",
        ".kit/**",
        "kit.json",
        "config/**",
        "Makefile",
        ".gitignore",
        ".node-version"
      ],
      "targets": [
        "kit-check",
        "owner-validate",
        "documents-check",
        "commits-check",
        "toolchain-check",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        ".githooks/**"
      ],
      "targets": [
        "hooks-check"
      ]
    },
    {
      "paths": [
        "**/*.md"
      ],
      "targets": [
        "documents-check"
      ]
    },
    {
      "paths": [
        "scripts/check-layout.mjs",
        "tests/check-layout/**"
      ],
      "targets": [
        "layout-test",
        "layout-check"
      ]
    },
    {
      "paths": [
        "contracts/layout.json"
      ],
      "targets": [
        "layout-test",
        "layout-check"
      ]
    },
    {
      "paths": [
        "scripts/check-parity.mjs",
        "tests/check-parity/**"
      ],
      "targets": [
        "parity-test"
      ]
    },
    {
      "paths": [
        "packages/status-compiler/**",
        "schema/status.schema.json",
        "machines/**",
        "status.lock.json",
        "conformance/**",
        "contracts/features.json",
        "status.config.json"
      ],
      "targets": [
        "compiler-test",
        "gen-check",
        "gui-test"
      ]
    },
    {
      "paths": [
        "scripts/gen-check.mjs",
        "tests/gen-check/**"
      ],
      "targets": [
        "gen-check-test",
        "gen-check"
      ]
    },
    {
      "paths": [
        "packages/status-db/**",
        "schema/status.dbs"
      ],
      "targets": [
        "db-test",
        "dependency-policy-check",
        "gui-test"
      ]
    },
    {
      "paths": [
        "contracts/layout.json"
      ],
      "targets": [
        "layout-test",
        "layout-check",
        "gen-check",
        "packages-test"
      ]
    },
    {
      "paths": [
        "packages/status-npm/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "parity-npm",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        "packages/status-go/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "parity-go",
        "dependency-policy-check",
        "toolchain-check"
      ]
    },
    {
      "paths": [
        "schema/persist.dbs"
      ],
      "targets": [
        "gen-check",
        "packages-test"
      ]
    },
    {
      "paths": [
        "packages/status-gui/**"
      ],
      "targets": [
        "gui-test",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        "packages/status-compiler/**",
        "schema/status.schema.json",
        "machines/**",
        "status.lock.json",
        "conformance/**",
        "contracts/features.json",
        "status.config.json"
      ],
      "targets": [
        "compiler-test",
        "gen-check"
      ]
    },
    {
      "paths": [
        "packages/status-db/**",
        "schema/status.dbs"
      ],
      "targets": [
        "db-test",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        "packages/status-php/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "parity-php",
        "dependency-policy-check",
        "toolchain-check"
      ]
    }
  ]
}
