        "scripts/kit/**",
        "tests/kit/**",
        ".kit/**",
        "kit.json",
        "config/**",
        "Makefile",
        ".gitignore",
        ".node-version"
      ],
      "targets": [
        "kit-check",
        "owner-validate",
        "documents-check",
        "commits-check",
        "toolchain-check",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        ".githooks/**"
      ],
      "targets": [
        "hooks-check"
      ]
    },
    {
      "paths": [
