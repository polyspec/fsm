{
  "name": "@polyspec/fsm",
  "version": "0.0.1",
  "description": "npm consumer test bed of fsm: the generated state machines, the conformance vectors and the B-4 persistence example (docs/plans/fsm-v1/plan.md, C-2)",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": "./src/*"
  },
  "types": "./src/index.d.ts",
  "main": "./src/index.js",
  "files": [
    "src"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.0"
  },
  "devDependencies": {
    "@polyspec/ordered-json": "https://github.com/polyspec/ordered-json/releases/download/v0.0.16/polyspec-ordered-json-0.0.16.tgz",
    "@polyspec/orm": "https://github.com/polyspec/orm/releases/download/v0.0.20/polyspec-orm-0.0.20.tgz",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@polyspec/ordered-json": "$@polyspec/ordered-json"
  },
  "scripts": {
    "prepack": "node ../compiler/src/cli/fsm-gen.mjs gen --project ../../contracts --kind npm --out src"
  }
}
