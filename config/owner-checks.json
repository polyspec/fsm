{
  "schema": 1,
  "comment": "The checks that own each tracked path, read by kit's owner-check: during an item only the owners of the changed paths run; make check runs the full suite once per tree. Each checklist item adds the rules of the paths it creates.",
  "owners": [
    {
      "paths": [
        "**"
      ],
      "targets": [
        "name-check"
      ]
    },
    {
      "paths": [
        "scripts/check-name.mts",
        "tests/check-name/**"
      ],
      "targets": [
        "name-test",
        "name-check"
      ]
    },
    {
      "paths": [
        "scripts/kit/**",
        "package.json",
        "package-lock.json",
        "PRINCIPLES.md",
        "PRINCIPLES.ko.md",
        "ruff.toml",
        "phpcs.xml.dist",
        "phpstan.dist.neon",
        ".golangci.yml",
        ".oxlintrc.json",
        "knip.json",
        ".editorconfig",
        "config/**",
        "Makefile",
        ".gitignore",
        ".node-version"
      ],
      "targets": [
        "kit-check",
        "owner-validate",
        "documents-check",
        "commits-check",
        "toolchain-check",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        ".githooks/**"
      ],
      "targets": [
        "hooks-check"
      ]
    },
    {
      "paths": [
        "**/*.md"
      ],
      "targets": [
        "documents-check"
      ]
    },
    {
      "paths": [
        "config/layout.yml",
        "config/layout.kit.yml"
      ],
      "targets": [
        "layout-check"
      ]
    },
    {
      "paths": [
        "packages/compiler/**",
        "contracts/schema/fsm.schema.json",
        "contracts/machines/**",
        "contracts/fsm.lock.json",
        "contracts/conformance/**",
        "contracts/features.json",
        "contracts/fsm.config.json"
      ],
      "targets": [
        "compiler-test",
        "gen-check",
        "gui-test"
      ]
    },
    {
      "paths": [
        "scripts/gen-check.mts",
        "tests/gen-check/**"
      ],
      "targets": [
        "gen-check-test",
        "gen-check"
      ]
    },
    {
      "paths": [
        "packages/db/**",
        "packages/db/schema/**"
      ],
      "targets": [
        "db-test",
        "dependency-policy-check",
        "gui-test",
        "db-test-postgres",
        "db-test-mysql"
      ]
    },
    {
      "paths": [
        "config/gen-check.json",
        "config/parity.json"
      ],
      "targets": [
        "gen-check",
        "packages-test",
        "parity-declarations-check"
      ]
    },
    {
      "paths": [
        "packages/js/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "test-npm",
        "npm-types",
        "dependency-policy-check",
        "npm-persist-test",
        "npm-persist-test-postgres",
        "npm-persist-test-mysql"
      ]
    },
    {
      "paths": [
        "packages/go/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "test-go",
        "dependency-policy-check",
        "toolchain-check",
        "go-persist-test-postgres",
        "go-persist-test-mysql"
      ]
    },
    {
      "paths": [
        "contracts/schema/persist.dbs",
        "contracts/schema/dbspec-set.json"
      ],
      "targets": [
        "gen-check",
        "packages-test"
      ]
    },
    {
      "paths": [
        "packages/gui/**"
      ],
      "targets": [
        "gui-test",
        "gui-browser-test",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        "packages/compiler/**",
        "contracts/schema/fsm.schema.json",
        "contracts/machines/**",
        "contracts/fsm.lock.json",
        "contracts/conformance/**",
        "contracts/features.json",
        "contracts/fsm.config.json"
      ],
      "targets": [
        "compiler-test",
        "gen-check"
      ]
    },
    {
      "paths": [
        "packages/db/**",
        "packages/db/schema/**"
      ],
      "targets": [
        "db-test",
        "dependency-policy-check",
        "db-test-postgres",
        "db-test-mysql"
      ]
    },
    {
      "paths": [
        "packages/php/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "test-php",
        "dependency-policy-check",
        "toolchain-check",
        "php-persist-test-postgres",
        "php-persist-test-mysql"
      ]
    },
    {
      "paths": [
        "scripts/kit/**",
        "package.json",
        "package-lock.json",
        "PRINCIPLES.md",
        "PRINCIPLES.ko.md",
        "ruff.toml",
        "phpcs.xml.dist",
        "phpstan.dist.neon",
        ".golangci.yml",
        ".oxlintrc.json",
        "knip.json",
        ".editorconfig",
        "config/**",
        "Makefile",
        ".gitignore",
        ".node-version",
        "rust-toolchain.toml"
      ],
      "targets": [
        "kit-check",
        "owner-validate",
        "documents-check",
        "commits-check",
        "toolchain-check",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        "packages/rust/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "rust-persist-test",
        "test-rust",
        "dependency-policy-check",
        "toolchain-check",
        "rust-persist-test-postgres",
        "rust-persist-test-mysql"
      ]
    },
    {
      "paths": [
        "packages/js/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "test-npm",
        "dependency-policy-check",
        "npm-persist-test",
        "npm-persist-test-postgres",
        "npm-persist-test-mysql"
      ]
    },
    {
      "paths": [
        "packages/python/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "test-python",
        "dependency-policy-check",
        "toolchain-check",
        "python-lock-check",
        "python-persist-test-postgres",
        "python-persist-test-mysql"
      ]
    },
    {
      "paths": [
        "packages/php-ext/**"
      ],
      "targets": [
        "layout-check",
        "gen-check",
        "test-php-ext",
        "dependency-policy-check",
        "toolchain-check",
        "php-ext-persist-test-postgres",
        "php-ext-persist-test-mysql"
      ]
    },
    {
      "paths": [
        "**/*.md",
        "docs/.vitepress/**"
      ],
      "targets": [
        "docs-build"
      ]
    },
    {
      "paths": [
        "scripts/check-readmes.mts",
        "tests/check-readmes/**"
      ],
      "targets": [
        "readme-test",
        "readme-check"
      ]
    },
    {
      "paths": [
        "**/README.md",
        "**/README.ko.md"
      ],
      "targets": [
        "readme-check"
      ]
    },
    {
      "paths": [
        "docs/package.json",
        "docs/package-lock.json"
      ],
      "targets": [
        "docs-build",
        "dependency-policy-check"
      ]
    },
    {
      "paths": [
        "tests/docs-build/**"
      ],
      "targets": [
        "docs-build-test"
      ]
    },
    {
      "paths": [
        ".github/workflows/**",
        "tests/workflows/**"
      ],
      "targets": [
        "workflows-test"
      ]
    },
    {
      "paths": [
        "tests/python-tools/**",
        "config/toolchain.json"
      ],
      "targets": [
        "python-tools-test"
      ]
    },
    {
      "paths": [
        "Makefile"
      ],
      "targets": [
        "python-tools-test"
      ]
    },
    {
      "paths": [
        "Makefile",
        "packages/*/Makefile",
        "tests/make-install/**"
      ],
      "targets": [
        "make-install-test"
      ]
    },
    {
      "paths": [
        "packages/python/pyproject.toml",
        "packages/python/constraints.txt",
        "packages/python/pylock.toml"
      ],
      "targets": [
        "python-lock-check"
      ]
    },
    {
      "paths": [
        "tests/support/**"
      ],
      "targets": [
        "name-test",
        "readme-test",
        "make-install-test",
        "python-tools-test"
      ]
    }
  ]
}
