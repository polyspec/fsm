.DS_Store
/var/
# The root packages of package-lock.json, @polyspec/kit among them (make install-packages).
/node_modules/
/.results/
/packages/*/node_modules/
# The documentation site (docs/.vitepress/config.mts, make docs-build): the packages it installs and its build output.
/docs/node_modules/
/docs/.vitepress/dist/
/docs/.vitepress/cache/
/packages/*/vendor/
/packages/*/target/
/packages/fsm-python/**/__pycache__/
/packages/fsm-python/.venv/
/packages/fsm-python/src/*.egg-info/
/packages/fsm-gui/build/
/packages/fsm-gui/public/assets/
/packages/fsm-php*/.phpunit.result.cache
/packages/fsm-php*/.phpunit.cache/
# phpize output of the php-ext package, built in its src/ (docs/plans/fsm-v1.md, C-1): config.m4 and the generated sources stay tracked.
/packages/fsm-php-ext/src/Makefile
/packages/fsm-php-ext/src/Makefile.fragments
/packages/fsm-php-ext/src/Makefile.objects
/packages/fsm-php-ext/src/*.dep
/packages/fsm-php-ext/src/*.la
/packages/fsm-php-ext/src/*.lo
/packages/fsm-php-ext/src/*.o
/packages/fsm-php-ext/src/.libs/
/packages/fsm-php-ext/src/autom4te.cache/
/packages/fsm-php-ext/src/build/
/packages/fsm-php-ext/src/config.h
/packages/fsm-php-ext/src/config.h.in
/packages/fsm-php-ext/src/config.h.in~
/packages/fsm-php-ext/src/config.log
/packages/fsm-php-ext/src/config.nice
/packages/fsm-php-ext/src/config.status
/packages/fsm-php-ext/src/configure
/packages/fsm-php-ext/src/configure.ac
/packages/fsm-php-ext/src/configure~
/packages/fsm-php-ext/src/libtool
/packages/fsm-php-ext/src/modules/
/packages/fsm-php-ext/src/run-tests.php
