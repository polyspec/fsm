.DS_Store
/var/
# The root packages of package-lock.json, @polyspec/kit among them (make install-packages).
/node_modules/
/.results/
/packages/*/node_modules/
/legacy/packages/*/node_modules/
# The documentation site (docs/.vitepress/config.mts, make docs-build): the packages it installs and its build output.
/docs/node_modules/
/docs/.vitepress/dist/
/docs/.vitepress/cache/
/packages/*/vendor
/packages/*/target/
/legacy/packages/*/vendor
/legacy/packages/*/target/
/legacy/packages/python/**/__pycache__/
/legacy/packages/python/.venv/
/legacy/packages/python/src/*.egg-info/
# The files that fsm-gen and orm-gen write (make fsm-gen and make fsm-db-gen; AGENTS.md, Generated files). The golden files of
# legacy/packages/compiler/tests/golden are their tracked proof. /legacy/packages/php-ext/src/ holds the phpize output too. legacy/packages/go/src and
# legacy/packages/rust/src are tracked: the Go module and the Rust crate are installed as the tagged tree (P34, config/generated.json).
/legacy/packages/db/src/models/
/legacy/packages/go/examples/model/
/legacy/packages/js/src/
/legacy/packages/js/examples/model/
/legacy/packages/php/src/
/legacy/packages/php/examples/model/
/legacy/packages/php-ext/src/
/legacy/packages/php-ext/tests/
/legacy/packages/php-ext/examples/
/legacy/packages/python/src/polyspec_fsm/
/legacy/packages/python/examples/model/
/packages/gui/build/
# The files that make bindings writes from packages/rust/interface.json (binding L-1, S-454), the Go files zz_generated_*.go of the
# Go module packages/go among them.
/packages/ts/generated/
/packages/ts/wasm/generated/
/packages/python/generated/
/packages/php-ext/generated/
/packages/go/internal/ffi/generated/
/packages/go/**/zz_generated_*.go
/packages/gui/public/assets/
/legacy/packages/php*/.phpunit.result.cache
/legacy/packages/php*/.phpunit.cache/

# Generated files of the install, build, cache and test runs (AGENTS.md, Generated files)
vendor/
target/
dist/
dist.next/
dist.old/
*.tsbuildinfo
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.phpunit.cache/
.phpunit.result.cache
test-results/
playwright-report/
coverage/

# The go.work that kit link writes for each Go module (kit local-links)
go.work
go.work.sum
