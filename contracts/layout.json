{
  "schema": 1,
  "comment": "The canonical layout of the language packages (docs/plans/status-v1.md, C-2): every kind package holds the canonical files and directories, its required files and only files that its allowed globs match. Each package item (S-09-1 to S-14-1) adds its kind.",
  "tools": ["status-compiler", "status-db", "status-gui"],
  "canonical": {
    "files": ["README.md", "README.ko.md", "Makefile"],
    "directories": ["src", "tests", "examples"]
  },
  "kinds": {
    "go": {
      "required": ["go.mod", "go.sum", "tests/conformance_test.go", "tests/vectors_test.go", "examples/persist.go"],
      "allowed": ["src/**/*.go", "examples/model/**"],
      "generated": ["src/**", "tests/vectors_test.go", "examples/model/**"]
    },
    "npm": {
      "required": ["package.json", "package-lock.json", "tests/conformance.test.mjs", "tests/vectors.mjs", "examples/persist.mjs"],
      "allowed": ["src/*.js", "src/*.d.ts", "examples/model/**"],
      "generated": ["src/**", "tests/vectors.mjs", "examples/model/**"]
    },
    "php": {
      "required": ["composer.json", "composer.lock", "tests/ConformanceTest.php", "tests/Vectors.php", "examples/persist.php"],
      "allowed": ["src/**/*.php", "examples/model/**"],
      "generated": ["src/**", "tests/Vectors.php", "examples/model/**"]
    }
  }
}
